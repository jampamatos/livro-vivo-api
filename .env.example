DJANGO_ENV=development
DJANGO_SECRET_KEY=
DEBUG=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
DJANGO_OFFLINE_MIGRATION_CHECK=true
REDIS_URL=redis://127.0.0.1:6379/1
DJANGO_CACHE_TIMEOUT_SECONDS=300
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:19006,http://127.0.0.1:19006
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_VERSION=dev
DJANGO_LOG_PROFILE=dev
DJANGO_LOG_LEVEL=
DJANGO_LOG_DJANGO_LEVEL=
DJANGO_LOG_INCLUDE_REQUESTS=true
DJANGO_LOG_STRUCTURED=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_PROXY_SSL_HEADER_ENABLED=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
DJANGO_STORAGE_PROVIDER=filesystem
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=media
DJANGO_MEDIA_PUBLIC_CACHE_CONTROL=public, max-age=86400, stale-while-revalidate=604800
DJANGO_MEDIA_PRIVATE_CACHE_CONTROL=private, max-age=300, no-store
DJANGO_STORAGE_S3_BUCKET_NAME=
DJANGO_STORAGE_S3_ENDPOINT_URL=
DJANGO_STORAGE_S3_REGION_NAME=
DJANGO_STORAGE_S3_ACCESS_KEY_ID=
DJANGO_STORAGE_S3_SECRET_ACCESS_KEY=
DJANGO_STORAGE_S3_CUSTOM_DOMAIN=
DJANGO_STORAGE_S3_QUERYSTRING_EXPIRE=300
DJANGO_AVATAR_MAX_UPLOAD_BYTES=5242880
DJANGO_AVATAR_MAX_DIMENSION=1024
DJANGO_AVATAR_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_PUSH_PROVIDER=noop
NOTIFICATIONS_FCM_PROJECT_ID=
NOTIFICATIONS_APNS_TOPIC=
PUSH_AUTODISPATCH_ENABLED=true
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=
TEMPLATES_BANK_DOWNLOAD_TOKEN_MAX_AGE_SECONDS=60
TEMPLATES_BANK_REMOTE_FILE_FETCH_TIMEOUT_SECONDS=8
TEMPLATES_BANK_REMOTE_FILE_MAX_BYTES=31457280
SOCIAL_AUTH_ALLOWED_REDIRECT_URIS=http://localhost:8081/auth/callback,http://127.0.0.1:8081/auth/callback,livrovivo://auth/callback
SOCIAL_AUTH_STATE_MAX_AGE_SECONDS=600
SOCIAL_AUTH_RESULT_TOKEN_MAX_AGE_SECONDS=300
SOCIAL_AUTH_HTTP_TIMEOUT_SECONDS=8
SOCIAL_AUTH_GOOGLE_ENABLED=false
SOCIAL_AUTH_GOOGLE_CLIENT_ID=
SOCIAL_AUTH_GOOGLE_CLIENT_SECRET=
SOCIAL_AUTH_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
SOCIAL_AUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
SOCIAL_AUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
SOCIAL_AUTH_GOOGLE_SCOPES=openid,email,profile
SOCIAL_AUTH_LINKEDIN_ENABLED=false
SOCIAL_AUTH_LINKEDIN_CLIENT_ID=
SOCIAL_AUTH_LINKEDIN_CLIENT_SECRET=
SOCIAL_AUTH_LINKEDIN_AUTHORIZATION_URL=https://www.linkedin.com/oauth/v2/authorization
SOCIAL_AUTH_LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
SOCIAL_AUTH_LINKEDIN_USERINFO_URL=https://api.linkedin.com/v2/userinfo
SOCIAL_AUTH_LINKEDIN_SCOPES=openid,profile,email
DJANGO_METRICS_ENABLED=false
DJANGO_METRICS_BEARER_TOKEN=
GRAFANA_BETA_DASHBOARD_URL=
CLIENT_TELEMETRY_ENABLED=true
CLIENT_TELEMETRY_SHARED_SECRET=
CLIENT_TELEMETRY_MAX_BYTES=8192
CLIENT_TELEMETRY_RATE_LIMIT=120/min
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
