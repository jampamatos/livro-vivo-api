DJANGO_ENV=development
DJANGO_SECRET_KEY=
DEBUG=true
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
REDIS_URL=
DJANGO_CACHE_TIMEOUT_SECONDS=300
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,http://localhost:19006,http://127.0.0.1:19006
DJANGO_CSRF_TRUSTED_ORIGINS=
APP_VERSION=dev
DJANGO_LOG_PROFILE=dev
DJANGO_LOG_LEVEL=
DJANGO_LOG_DJANGO_LEVEL=
DJANGO_LOG_INCLUDE_REQUESTS=true
DJANGO_LOG_STRUCTURED=false
TEMPLATES_BANK_DOWNLOAD_TOKEN_MAX_AGE_SECONDS=300
TEMPLATES_BANK_REMOTE_FILE_FETCH_TIMEOUT_SECONDS=8
TEMPLATES_BANK_REMOTE_FILE_MAX_BYTES=31457280
