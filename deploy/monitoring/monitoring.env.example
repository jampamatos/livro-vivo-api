GRAFANA_CLOUD_ENVIRONMENT=beta

# Grafana Cloud Loki endpoint for logs.
# Example: https://logs-prod-000.grafana.net/loki/api/v1/push
GRAFANA_CLOUD_LOKI_URL=
GRAFANA_CLOUD_LOKI_USERNAME=
GRAFANA_CLOUD_LOKI_PASSWORD=

# Grafana Cloud Prometheus remote_write endpoint for infrastructure metrics.
# Example: https://prometheus-prod-000.grafana.net/api/prom/push
GRAFANA_CLOUD_PROMETHEUS_REMOTE_WRITE_URL=
GRAFANA_CLOUD_PROMETHEUS_USERNAME=
GRAFANA_CLOUD_PROMETHEUS_PASSWORD=

# Docker Compose project name used by the API stack on the VPS.
# Confirm with: docker compose ls
MONITORED_DOCKER_COMPOSE_PROJECT=livro-vivo-api

# Pin this image after the first successful rollout if operations require
# reproducible monitoring upgrades.
ALLOY_IMAGE=grafana/alloy:latest
