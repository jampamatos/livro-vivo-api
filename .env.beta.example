DJANGO_ENV=stage
DEBUG=false
# Set in deploy environment. Do not commit a real secret here.
DJANGO_SECRET_KEY=
# Keep the password portion aligned with POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://livro_vivo:${POSTGRES_PASSWORD}@postgres:5432/livro_vivo
REDIS_URL=redis://redis:6379/1
POSTGRES_DB=livro_vivo
POSTGRES_USER=livro_vivo
POSTGRES_PASSWORD=
DJANGO_ALLOWED_HOSTS=api.vitorguglinski.jur.br
DJANGO_CORS_ALLOWED_ORIGINS=https://app.vitorguglinski.jur.br
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.vitorguglinski.jur.br
APP_VERSION=beta
DJANGO_OFFLINE_MIGRATION_CHECK=false
DJANGO_LOG_PROFILE=prod
DJANGO_LOG_STRUCTURED=true
DJANGO_LOG_INCLUDE_REQUESTS=false
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_PROXY_SSL_HEADER_ENABLED=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=false
APP_PUBLIC_BASE_URL=https://app.vitorguglinski.jur.br
PASSWORD_RESET_CONFIRM_URL=https://app.vitorguglinski.jur.br/?password_reset=1
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_DEFAULT_FROM_EMAIL=Livro Vivo <no-reply@vitorguglinski.jur.br>
DJANGO_STORAGE_PROVIDER=filesystem
DJANGO_MEDIA_URL=/media/
DJANGO_MEDIA_ROOT=media
DJANGO_MEDIA_PUBLIC_CACHE_CONTROL=public, max-age=86400, stale-while-revalidate=604800
DJANGO_MEDIA_PRIVATE_CACHE_CONTROL=private, max-age=300, no-store
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_PUSH_PROVIDER=noop
NOTIFICATIONS_FCM_PROJECT_ID=
NOTIFICATIONS_APNS_TOPIC=
PUSH_AUTODISPATCH_ENABLED=true
EXPO_PUSH_API_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_ACCESS_TOKEN=
TEMPLATES_BANK_DOWNLOAD_TOKEN_MAX_AGE_SECONDS=60
SOCIAL_AUTH_ALLOWED_REDIRECT_URIS=https://livro-vivo-app.jampa-matos.workers.dev/auth/callback,livrovivo://auth/callback
SOCIAL_AUTH_STATE_MAX_AGE_SECONDS=600
SOCIAL_AUTH_RESULT_TOKEN_MAX_AGE_SECONDS=300
SOCIAL_AUTH_HTTP_TIMEOUT_SECONDS=8
SOCIAL_AUTH_GOOGLE_ENABLED=false
SOCIAL_AUTH_GOOGLE_CLIENT_ID=
SOCIAL_AUTH_GOOGLE_CLIENT_SECRET=
SOCIAL_AUTH_GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
SOCIAL_AUTH_GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
SOCIAL_AUTH_GOOGLE_USERINFO_URL=https://openidconnect.googleapis.com/v1/userinfo
SOCIAL_AUTH_GOOGLE_SCOPES=openid,email,profile
SOCIAL_AUTH_LINKEDIN_ENABLED=false
SOCIAL_AUTH_LINKEDIN_CLIENT_ID=
SOCIAL_AUTH_LINKEDIN_CLIENT_SECRET=
SOCIAL_AUTH_LINKEDIN_AUTHORIZATION_URL=https://www.linkedin.com/oauth/v2/authorization
SOCIAL_AUTH_LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
SOCIAL_AUTH_LINKEDIN_USERINFO_URL=https://api.linkedin.com/v2/userinfo
SOCIAL_AUTH_LINKEDIN_SCOPES=openid,profile,email
DJANGO_METRICS_ENABLED=false
DJANGO_METRICS_BEARER_TOKEN=
SENTRY_DSN=
SENTRY_ENVIRONMENT=beta
SENTRY_TRACES_SAMPLE_RATE=0.0
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
CADDY_SITE_ADDRESS=api.vitorguglinski.jur.br
